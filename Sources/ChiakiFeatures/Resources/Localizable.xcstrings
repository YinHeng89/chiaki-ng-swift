    "playback.tips.wifiMoveCloser" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move this device and your wireless router closer together for the strongest signal. Doors, walls and cabinets between them weaken the connection."
          }
        },
