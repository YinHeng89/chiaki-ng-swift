    "mobile.network.discoveryFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local networks are discovered automatically. Add other subnets to search them directly. One subnet per line, /24–/32. Up to 1,024 addresses. Local subnets use broadcast."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地网络会自动发现。可添加其他子网以直接搜索。每行一个子网，/24–/32，最多 1,024 个地址。本地子网使用广播。"
          }
        }
      }
    },
    "mobile.network.dropFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A console stream that loses its connection connects again, up to three times, instead of ending."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接断开后，串流会自动重连最多三次，而不是直接结束。"
          }
        }
      }
    },
    "mobile.network.internetConnections" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Internet Connections"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "互联网连接"
          }
        }
      }
    },
    "mobile.network.internetFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connections through the PlayStation Network guess ports only when the router needs it. Turn this on if Internet connections fail behind a strict router. More guesses can get through stricter routers but take longer to connect."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "经由 PlayStation 网络的连接仅在路由器需要时才猜测端口。如果互联网连接在严格的路由器后面失败，请开启此选项。更多端口猜测能穿过更严格的路由器，但连接耗时更长。"
          }
        }
      }
    },
