    "settings.network.natMappedDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device is behind a router that keeps one public address and port for it. Remote Play over the internet usually connects."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备位于一台为其保留单一公网地址和端口的路由器之后。通过互联网进行的远程游玩通常可以连接。"
          }
        }
      }
    },
