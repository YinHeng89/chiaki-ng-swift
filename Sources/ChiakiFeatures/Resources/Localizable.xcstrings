    "mobile.controls.noteDisconnected" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This controller isn’t connected. You can still change its bindings: choose an action, then tap the button you want."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此控制器未连接。你仍可更改其按键绑定：选择一个操作，然后轻点想要的按钮。"
          }
        }
      }
    },
    "mobile.controls.noteFirstChange" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose an action, then press the button you want for it. Your first change saves a preset just for this controller."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择一个操作，然后按下要分配给它的按键。首次更改会为此控制器单独保存一个预设。"
          }
        }
      }
    },
    "mobile.controls.noteKeyboard" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The keyboard plays as player 1. Choose an action, then press the key you want for it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "键盘作为玩家 1 使用。请选择一个操作，然后按下要分配给它的按键。"
          }
        }
      }
    },
    "mobile.controls.noteOwnPreset" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose an action, then press the button you want for it. A player’s own bindings take priority over these."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择一个操作，然后按下要分配给它的按键。玩家自己的按键映射优先于此设置。"
          }
        }
      }
    },
    "mobile.controls.notePlayerJoinOwn" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Player %(joining)lld joins by pressing the PS button on a controller during a stream. These bindings follow player %(player)lld whichever controller they hold."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "串流过程中，玩家 %(joining)lld 可通过按下控制器上的 PS 键加入。无论手持哪个控制器，这些按键映射都会跟随玩家 %(player)lld。"
          }
        }
      }
    },
    "mobile.controls.notePlayerJoinShared" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Player %(joining)lld joins by pressing the PS button on a controller during a stream. Player %(player)lld uses each controller’s own bindings. Your first change gives them bindings of their own, used whichever controller they hold."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "串流过程中，玩家 %(joining)lld 可通过按下控制器上的 PS 键加入。玩家 %(player)lld 使用各控制器自身的按键映射。你的首次更改会为其单独保存一套按键映射，无论手持哪个控制器都会使用。"
          }
        }
      }
    },
    "mobile.controls.notePlayerOwn" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These bindings follow player %(player)lld whichever controller they hold."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无论手持哪个控制器，这些按键映射都会跟随玩家 %(player)lld。"
          }
        }
      }
    },
