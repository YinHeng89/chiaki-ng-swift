      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Player %(player)lld uses each controller’s own bindings. Your first change gives them bindings of their own, used whichever controller they hold."
