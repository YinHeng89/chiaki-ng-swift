include(FetchContent)
set(SDL_SHARED ON CACHE BOOL "" FORCE)
set(SDL_STATIC OFF CACHE BOOL "" FORCE)
set(SDL_TEST_LIBRARY OFF CACHE BOOL "" FORCE)
set(SDL_TESTS OFF CACHE BOOL "" FORCE)
set(SDL_EXAMPLES OFF CACHE BOOL "" FORCE)
if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
    set(SDL_VIDEO ON CACHE BOOL "" FORCE)
    set(SDL_OPENGLES OFF CACHE BOOL "" FORCE)
    set(SDL_VULKAN OFF CACHE BOOL "" FORCE)
else()
    set(SDL_VIDEO OFF CACHE BOOL "" FORCE)
endif()
set(SDL_AUDIO ON CACHE BOOL "" FORCE)
set(SDL_RENDER OFF CACHE BOOL "" FORCE)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
FetchContent_Declare(SDL3
    URL https://github.com/chiaki-ng/native-deps/releases/download/sources/SDL3-3.4.16.tar.gz
        https://github.com/libsdl-org/SDL/releases/download/release-3.4.16/SDL3-3.4.16.tar.gz
    URL_HASH SHA256=7322236cd12090c3eb40b9728be4d49c76f66ad17d04369584d4ecad5cf77c68
    DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
FetchContent_MakeAvailable(SDL3)
set_target_properties(SDL3-shared PROPERTIES LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}")
execute_process(COMMAND "${CMAKE_COMMAND}" -DSDL_SOURCE=${sdl3_SOURCE_DIR}
    -DPATCH_FILE=${CMAKE_CURRENT_LIST_DIR}/patches/sdl3-dualsense-waveform.patch
    -P "${CMAKE_CURRENT_LIST_DIR}/patches/ApplySDL.cmake" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" -DSDL_SOURCE=${sdl3_SOURCE_DIR}
    -DPATCH_FILE=${CMAKE_CURRENT_LIST_DIR}/patches/sdl3-dualsense-trigger-state.patch
    -P "${CMAKE_CURRENT_LIST_DIR}/patches/ApplySDL.cmake" COMMAND_ERROR_IS_FATAL ANY)
add_library(ChiakiInput SHARED bridge/input.cpp bridge/input_commands.cpp bridge/dualsense.cpp bridge/switch_rumble.cpp)
target_link_libraries(ChiakiInput PRIVATE SDL3::SDL3 "-framework CoreFoundation")
target_compile_features(ChiakiInput PRIVATE cxx_std_20)
set_target_properties(ChiakiInput PROPERTIES INSTALL_NAME_DIR "@rpath" BUILD_WITH_INSTALL_NAME_DIR TRUE)
if(CMAKE_CROSSCOMPILING)
    return()
endif()
add_executable(chiaki-input-test ../Tests/Native/NativeCoreTests/input.c bridge/input.cpp bridge/input_commands.cpp
    bridge/dualsense.cpp bridge/switch_rumble.cpp)
target_include_directories(chiaki-input-test PRIVATE bridge)
target_link_libraries(chiaki-input-test PRIVATE SDL3::SDL3 "-framework CoreFoundation")
target_compile_features(chiaki-input-test PRIVATE cxx_std_20)
add_test(NAME chiaki-input-test COMMAND chiaki-input-test)
add_executable(chiaki-dualsense-test ../Tests/Native/NativeCoreTests/dualsense.cpp bridge/dualsense.cpp)
target_include_directories(chiaki-dualsense-test PRIVATE bridge)
target_compile_features(chiaki-dualsense-test PRIVATE cxx_std_20)
add_test(NAME chiaki-dualsense-test COMMAND chiaki-dualsense-test)
add_executable(chiaki-switch-rumble-test ../Tests/Native/NativeCoreTests/switch-rumble.cpp bridge/switch_rumble.cpp)
target_include_directories(chiaki-switch-rumble-test PRIVATE bridge)
target_compile_features(chiaki-switch-rumble-test PRIVATE cxx_std_20)
add_test(NAME chiaki-switch-rumble-test COMMAND chiaki-switch-rumble-test)
add_executable(chiaki-input-commands-test ../Tests/Native/NativeCoreTests/input-commands.c bridge/input_commands.cpp)
target_include_directories(chiaki-input-commands-test PRIVATE bridge)
target_compile_features(chiaki-input-commands-test PRIVATE cxx_std_20)
add_test(NAME chiaki-input-commands-test COMMAND chiaki-input-commands-test)
